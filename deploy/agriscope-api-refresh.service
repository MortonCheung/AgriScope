[Unit]
Description=Rebind AgriScope API after a validated immutable publication

[Service]
Type=oneshot
ExecCondition=/bin/systemctl is-active --quiet agriscope-api.service
ExecStart=/bin/systemctl try-restart agriscope-api.service
ExecStartPost=/opt/agriscope/.venv/bin/python scripts/check_ready.py --timeout 60
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
