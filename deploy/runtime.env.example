# Product code and published runtime. API reads only this root.
AGRISCOPE_ROOT=/opt/agriscope
# Independent worker stores new raw/processed/log/lock files; never use the product root.
PROJECT_ROOT=/srv/agriscope-worker
AGRISCOPE_API_HOST=127.0.0.1
AGRISCOPE_API_PORT=8787
AGRISCOPE_SNAPSHOT_POLICY=auto
AGRISCOPE_MARKET_POLICY=observed
ALLOWED_ORIGINS=https://YOUR_DOMAIN
# Optional product decision provider. Keep real values only in /etc/agriscope/runtime.env.
AGRISCOPE_PRODUCT_LLM_ENABLED=false
AGRISCOPE_PRODUCT_LLM_TIMEOUT=12
AGRISCOPE_LLM_API_KEY=
AGRISCOPE_LLM_BASE_URL=https://api.openai.com/v1
AGRISCOPE_LLM_MODEL=

# Service budget: three bounded stages (seven-region market feed, Shenyang Daily
# model chain, long-horizon) plus two atomic publications. Keep the sum below
# TimeoutStartSec (2400s in deploy/agriscope-daily-chain.service).
AGRISCOPE_MARKET_TIMEOUT_SECONDS=600
AGRISCOPE_DAILY_TIMEOUT_SECONDS=900
AGRISCOPE_LONG_TIMEOUT_SECONDS=720
# Optional override; by default the market feed stores under $PROJECT_ROOT/market_feed.
# AGRISCOPE_MARKET_FEED_HOME=/srv/agriscope-worker/market_feed
# AGRISCOPE_SOURCE_CA_FILE=/etc/ssl/certs/ca-certificates.crt
