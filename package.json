{
  "name": "agriscope",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "python3 -B server/agriscope_api.py --allow-origin http://localhost:5173 --allow-origin http://127.0.0.1:5173",
    "prebuild": "npm run verify:v2 && npm run verify:integrity && npm run verify:decision",
    "build": "tsc -b && vite build && node scripts/verify-production-boundary.mjs && npm run verify:ui",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && node scripts/verify-v2-payload.mjs && node scripts/verify-research-integrity.mjs",
    "test:unit": "vitest run",
    "test:api": "python3 -B -m unittest discover -s server/tests -v",
    "test:watch": "vitest",
    "sync": "node scripts/sync-shenyang-v2.mjs",
    "verify:v2": "node scripts/verify-v2-payload.mjs",
    "verify:integrity": "node scripts/verify-research-integrity.mjs",
    "verify:ui": "node scripts/verify-ui-strings.mjs",
    "verify:decision": "node scripts/verify-decision-fixtures.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3",
    "three": "^0.179.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
