# ============================================================================
# AgriScope v1.0 · 单仓库（ONE OFFICIAL REPOSITORY）
# 只追踪「源码与清单」；大型运行时资产由 runtime/manifest.json 管理。
# ============================================================================

# --- 依赖 / 构建 / 缓存 ---
node_modules/
dist/
output/
.vite/
.playwright-cli/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.DS_Store
*.log
.env

# --- 大型运行时资产（不进 Git；由 pipelines/publishing 从外层 data/models 生成）---
# runtime/manifest.json 仍在 Git 中，用于记录本次发布使用了哪些资产与版本。
runtime/models/models/
runtime/models/data/
runtime/models/evaluation/
runtime/models/reports/
runtime/models/registry/
runtime/models/src/
runtime/data/
runtime/research/
runtime/*.csv

# --- 归档 / 参考 / 训练缓存（不进 Git）---
archive/
reference/
catboost_info/

# --- LLM 调用缓存与中间产物 ---
# llm/cache contains Python source; response caches live under llm/artifacts/cache.
llm/artifacts/

# --- Long-Horizon 研究中间产物（大 parquet/csv；源与交付报告仍进 Git）---
pipelines/long_horizon/artifacts/
pipelines/long_horizon/reports/

# Mutable publication transaction state (never part of a source release).
runtime/.manifest.lock
runtime/publication_history/

# ============================================================================
# 过程材料（阶段报告 / 审计 / 浏览器证据）——不进 Git
# 远端只保留 README、架构、API、运行与数据契约；
# 阶段报告统一归档到仓库外 archive/reports/，避免再次上传。
# ============================================================================

# 根级过程报告
/RC[0-9]*.md
/PROJECT_STATUS.md
/*_REPORT.md
/*_AUDIT.md
/*_HANDOFF.md
/*_FREEZE_GATE.md

# 任意目录下的过程产物（施工总结 / 审计 / 交接 / 门禁）
*_AUDIT.md
*_HANDOFF.md
*_FREEZE_GATE.md

# 阶段证据目录
docs/v4/
docs/archive/
llm/reports/

# 前端过程文档（保留 DESIGN_SYSTEM / *_CONTRACT / ARCHITECTURE / MOTION / VISUAL 等契约）
frontend/docs/*_AUDIT.md
frontend/docs/*_REPORT.md
frontend/docs/*_PLAN.md
# 同步脚本会重新生成这些缺口/映射清单（研发态产物，不入 Git）
frontend/docs/*_GAPS.md
frontend/docs/*_MATRIX.md
frontend/docs/*_MAP.md

# ============================================================================
# 二进制归档 / 媒体产物（部署包统一归档到外层 archive/build_artifacts/）
# ============================================================================
*.tar.gz
*.tgz
*.zip
*.7z
*.mp4
*.mov
