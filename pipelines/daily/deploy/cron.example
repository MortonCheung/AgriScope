# 准备示例：没有自动安装或启用。PROJECT_ROOT 为已准备研发输入的独立 worker 目录。
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
CRON_TZ=Asia/Shanghai
PROJECT_ROOT=/srv/agriscope-worker
30 20 * * * cd /opt/agriscope && /opt/agriscope/.venv/bin/python scripts/run_daily_chain.py >> /srv/agriscope-worker/daily-chain.log 2>&1
30 23 * * * cd /opt/agriscope && /opt/agriscope/.venv/bin/python scripts/run_daily_chain.py >> /srv/agriscope-worker/daily-chain.log 2>&1
# 20:30 / 23:30 是保守工程调度，不是官方发布时间承诺。
# --dry-run 仍可能创建工作目录和日志；验收只能对临时 worker 执行。
