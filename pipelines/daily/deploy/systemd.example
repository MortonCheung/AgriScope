# 准备示例：拆为两个 unit 后由运维明确启用；本轮没有安装或启用。
# ---------------- agriscope-daily-chain.service ----------------
[Unit]
Description=AgriScope validated Daily and immutable runtime publication
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/agriscope
EnvironmentFile=/etc/agriscope/runtime.env
ExecStart=/opt/agriscope/.venv/bin/python scripts/run_daily_chain.py
TimeoutStartSec=1800
# ---------------- agriscope-daily-chain.timer ----------------
[Unit]
Description=AgriScope two daily attempts
[Timer]
OnCalendar=*-*-* 20:30:00 Asia/Shanghai
OnCalendar=*-*-* 23:30:00 Asia/Shanghai
Persistent=true
Unit=agriscope-daily-chain.service
[Install]
WantedBy=timers.target
