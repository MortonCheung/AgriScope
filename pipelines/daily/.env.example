# ============================================================================
# AgriScope Daily · 环境变量示例
# 复制为 .env（或写入服务器环境）后按需修改。
# 真实 secret 不要提交到版本库；本数据源为公开接口，无 API Key / Cookie / 密码。
# ============================================================================

# 项目根目录（服务器部署时必填；留空则由 data/daily/config.py 按文件位置推导）
AGRISCOPE_ROOT=/opt/agriscope

# 沈阳菜篮子信息发布平台数据接口（公开 GET，无需鉴权）
AGRISCOPE_SY_API=https://www.lnsyjgjc.com/api/showList

# 采集参数
AGRISCOPE_HTTP_TIMEOUT=30     # 单次请求超时（秒）
AGRISCOPE_HTTP_RETRIES=3      # 有限重试次数（不做无限重试）
AGRISCOPE_HTTP_SLEEP=0.8      # 请求间隔（秒），避免对来源造成压力