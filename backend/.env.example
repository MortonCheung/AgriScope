# ============================================================================
# AgriScope Decision API · 环境变量示例
# 复制为 backend/.env（或写入服务器环境 / systemd EnvironmentFile）。
# 本项目数据源为公开接口，无 API Key / Cookie / 密码，故不含任何 secret。
# ============================================================================

# 项目根目录（服务器部署时必填；留空则由 backend/app/config.py 按文件位置推导）
AGRISCOPE_ROOT=/opt/agriscope

# 监听地址与端口
AGRISCOPE_API_HOST=127.0.0.1
AGRISCOPE_API_PORT=8000

# 允许的跨域来源（逗号分隔）。留空 = 不启用 CORS（同源/反代部署）。
# 前端 Vite 开发服务器示例：
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 运行时快照策略：
#   auto   = 优先 Daily 的 extended_snapshot（指纹需与当前 Final 兼容），否则回退冻结 final_v1
#   frozen = 始终使用冻结 final_v1
AGRISCOPE_SNAPSHOT_POLICY=auto

# 推理串行化（1=开启，0=关闭）。Final 引擎含模块级/类级缓存，建议保持开启。
AGRISCOPE_INFERENCE_LOCK=1