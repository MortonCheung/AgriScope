# ============================================================================
# AgriScope · 环境变量示例（唯一示例；复制为 backend/.env）
#
# 加载方式：agriscope_env.load_env()（仓库根，唯一实现）。
#   1) 系统环境变量优先：已存在的键不会被本文件覆盖；
#   2) AGRISCOPE_ROOT / PROJECT_ROOT 只有指向**合法 AgriScope 根**时才会被采纳；
#   3) 本文档本身**不含任何 secret**；真实 Key 只写在未跟踪的 backend/.env。
# ============================================================================

# 项目根目录（本机可留空 → 按文件位置推导；服务器部署时必填）
# 只有该目录同时存在 backend/app/main.py、models/src/decision_engine/common.py、
# data/daily/run_daily.py 时才会生效，避免把模型/数据指向过期副本。
AGRISCOPE_ROOT=/opt/agriscope

# 监听地址与端口（本机开发用 8787，与 frontend Vite 代理一致）
AGRISCOPE_API_HOST=127.0.0.1
AGRISCOPE_API_PORT=8787

# 允许的跨域来源（逗号分隔）。留空 = 不启用 CORS（同源/反代部署）。
# 前端 Vite 开发服务器示例：
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 运行时快照策略：
#   auto   = 优先 Daily 的 extended_snapshot（指纹需与当前 Final 兼容），否则回退冻结 final_v1
#   frozen = 始终使用冻结 final_v1
AGRISCOPE_SNAPSHOT_POLICY=auto

# 推理串行化（1=开启，0=关闭）。Final 引擎含模块级/类级缓存，建议保持开启。
AGRISCOPE_INFERENCE_LOCK=1

# --- 可选：显式指定 .env 文件位置（默认 <AGRISCOPE_ROOT>/backend/.env）---
# AGRISCOPE_ENV_FILE=/etc/agriscope/runtime.env

# ============================================================================
# Long-Horizon LLM（OpenAI-compatible）。留空 = 不启用真实 LLM（数值链路不受影响）。
# Secret 只能写进 backend/.env 或服务器 /etc/agriscope/runtime.env（chmod 600），
# 绝不进入 Git、镜像层、前端产物或日志。
# ============================================================================
AGRISCOPE_LLM_API_KEY=
AGRISCOPE_LLM_BASE_URL=https://api.deepseek.com
AGRISCOPE_LLM_MODEL=deepseek-flash
AGRISCOPE_LLM_SEED_SUPPORTED=false
# 请求超时（秒）。真实非线性推理延迟约 35–70s，默认 180。
AGRISCOPE_LLM_TIMEOUT=180
# 可选：输出上限（含 reasoning tokens）。留空 = 不发送该参数。
# AGRISCOPE_LLM_MAX_TOKENS=4096
# 可选：瞬时故障重试（指数退避）。默认 3 次尝试。
AGRISCOPE_LLM_MAX_ATTEMPTS=3